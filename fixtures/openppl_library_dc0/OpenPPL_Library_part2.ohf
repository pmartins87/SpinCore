//*****************************************************************************


##EarlyStage##
When NOT PreBubble Return false Force
When Not f$Stack_12P Return false FORCE
// Was 5 changed to 3 Trish compatibility for most casinos today even non turbo
	// StartingBigBlindSize excellent for SnG & MTTSnG, but people tweeking this for MTTs
	// should consider late reg, and re-entry game types
WHEN (BigBlindSize <= (3 * StartingBigBlindSize)) RETURN true FORCE

##MiddleStage##
When NOT PreBubble Return false Force
WHEN EarlyStage RETURN false FORCE
WHEN LateStage RETURN false FORCE
WHEN Others RETURN true FORCE

##LateStage##
When NOT PreBubble Return false Force
When EarlyStage Return false Force
When BigBlindSize >= 160 And (TableMzone < 12 OR EffectiveMzone < 10) Return true FORCE
// @Trish check this temporary inclusion
When BigBlindSize >= 100 And Not f$Stack_12P Return true FORCE
When EffectiveMzone <= 10*f$Mfactor Return true FORCE

##BubbleStage##
When IsBubble Return true Force

##ITMStage##
When InTheMoney Return true Force

##HUStage##
When TableIsHeadsup Return true Force


##ShortStackStage##
When MTTGameStage = 4  And EffectiveMzone < 14*f$Mfactor Return true FORCE  // MTT Red Zone ShortStackStage
When HUStage  And EffectiveMzone < 20*f$Mfactor Return true FORCE
When ITMStage  And EffectiveMzone < 14*f$Mfactor Return true FORCE
When BubbleStage  And EffectiveMzone < 12*f$Mfactor Return true FORCE
When LateStage  And EffectiveMzone < 16*f$Mfactor Return true FORCE
When MiddleStage  And EffectiveMzone < 14*f$Mfactor Return true FORCE
When EarlyStage And EffectiveMzone < (StartingStackSize * 0.40)*f$Mfactor Return true FORCE
When isspin And Not ismtt And StartingStackSize = 25 And EffectiveMzone < 14*f$Mfactor Return true FORCE
When isspin And Not ismtt And StartingStackSize = 15 And EffectiveMzone < 8*f$Mfactor Return true FORCE
When isspin And ismtt And StartingStackSize = 25 And EffectiveMzone <= 12*f$Mfactor Return true FORCE
When isspin And ismtt And StartingStackSize = 15 And EffectiveMzone <= 5*f$Mfactor Return true FORCE


// Worth thinking about //
// More specific to STT SNG or MTT Final Table
// 1 = EarlyStage, 2 = MiddleStage, 3 = LateStage, 4 = BubbleStage, 5 = ITMStage, 6 = HUStage, and special ShortStackStage
##STTGameStage##
When HUStage 		Return 6 Force
When ITMStage 		Return 5 Force
When BubbleStage 	Return 4 Force
When LateStage 		Return 3 Force 
When MiddleStage 	Return 2 Force   
When EarlyStage 	Return 1 Force 

//////////////////////////////////////////////////////


##f$Stack_12P##
// WHEN EffectiveActiveStackInBigBlinds >= 12 Return true FORCE
EffectiveMzone >= 12*f$Mfactor


##Mzone##
balance / (bblind + sblind + (ante*nplayersseated))

##ActiveMzone##
(balance / (bblind + sblind) + (ante*nplayersseated)) * (nplayersseated / nchairs)

##EffectiveMzone##
((EffectiveActiveStackInBigBlinds * bblind) / (bblind + sblind + (ante*nplayersseated)))

##EffectiveActiveMzone##
((EffectiveActiveStackInBigBlinds * bblind) / (bblind + sblind + (ante*nplayersseated))) * (nplayersseated/nchairs)

##TableMzone##
((f$TableAverageStackAtStartOfHand*bblind)  / (bblind + sblind + ante))

##f$Mfactor##
bblind / (bblind + sblind + (ante*nplayersseated))

##f$TheBiggestActiveOpponentsChipsLegacy##
// This can be simplified from 13.1.3
bigstackchair == ep1chair ? balance_ep1chair + currentbet_ep1chair :
bigstackchair == ep2chair ? balance_ep2chair + currentbet_ep2chair :
bigstackchair == ep3chair ? balance_ep3chair + currentbet_ep3chair :
bigstackchair == mp1chair ? balance_mp1chair + currentbet_mp1chair :
bigstackchair == mp2chair ? balance_mp2chair + currentbet_mp2chair :
bigstackchair == mp3chair ? balance_mp3chair + currentbet_mp3chair :
bigstackchair == cutoffchair ? balance_cutoffchair + currentbet_cutoffchair :
bigstackchair == dealerchair ? balance_dealerchair + currentbet_dealerchair :
bigstackchair == smallblindchair ? balance_smallblindchair + currentbet_smallblindchair :
bigstackchair == bigblindchair ? balance_bigblindchair + currentbet_bigblindchair :
balance + currentbet

##f$TheBiggestActiveOpponentsChips##
balance_bigstackchair + currentbet_bigstackchair

##f$TheBiggestActiveOpponentsStack##
f$TheBiggestActiveOpponentsChips / bblind

##EffectiveActiveStackInBigBlinds##
balance + currentbet < f$TheBiggestActiveOpponentsChips ? (balance + currentbet) / bblind :
f$TheBiggestActiveOpponentsStack

##EffectiveStackInBigBlinds##
balance + currentbet < balance_bigstackchair + currentbet_bigstackchair ? (balance + currentbet) / bblind :
(balance_bigstackchair + currentbet_bigstackchair) / bblind

##EffectiveActiveStack##
balance + currentbet < f$TheBiggestActiveOpponentsChips ? balance + currentbet :
f$TheBiggestActiveOpponentsChips

##EffectiveStack##
balance + currentbet < balance_bigstackchair + currentbet_bigstackchair ? balance + currentbet :
balance_bigstackchair + currentbet_bigstackchair

##f$TotalDollarsAtThisTable##
// Different to TotalChipsAtTheTable this is not effective just relative
  pot
+ balance0
+ balance1
+ balance2
+ balance3
+ balance4
+ balance5
+ balance6
+ balance7
+ balance8
+ balance9

##f$TableAverageStackAtStartOfHand##
// Different to AverageStackSize, as that is based on effective pot size
(f$TotalDollarsAtThisTable/bblind) / nplayersdealt 


// More specific to MTT except Final Table
// 1 = Green Zone, 2 = Yellow Zone, 3 = Orange Zone, 4 = Red Zone, 5 = Dead Zone
##MTTGameStage##
When EffectiveMzone >= 20 							Return 1 Force 
When EffectiveMzone >= 13 And EffectiveMzone < 20 	Return 2 Force 
When EffectiveMzone >= 6 And EffectiveMzone < 13 	Return 3 Force 
When EffectiveMzone >= 3 And EffectiveMzone < 6 	Return 4 Force 
When EffectiveMzone>= 0 And EffectiveMzone < 3 		Return 5 Force 

//////////////////////////////////////////////////////


// Specific to Spin Games
// 1 = 3-Handed, 2 = Heads-Up
##STTSPinGameStage##
When TableIsThreeHanded Return 1 FORCE
When TableIsHeadsup 	Return 2 FORCE

// 1 = EarlyStage, 2 = MiddleStage, 3 = Heads-Up
##MTTSPinGameStage##
When StartingStackSize = 25 And EffectiveMzone > 17*f$Mfactor Return 1 FORCE
When StartingStackSize = 15 And EffectiveMzone > 10*f$Mfactor Return 1 FORCE
When StartingStackSize = 25 And EffectiveMzone > 12*f$Mfactor And EffectiveMzone <= 17*f$Mfactor Return 2 FORCE
When StartingStackSize = 15 And EffectiveMzone > 5*f$Mfactor And EffectiveMzone <= 10*f$Mfactor  Return 2 FORCE
When TableIsHeadsup Return 3 FORCE

//////////////////////////////////////////////////////


##PreBubble##
When TableIsHeadsup Return false FORCE
// Above is ok for now but maybe...
// When OnlyTwoPlayersLeftAtTournamentTable Return false FORCE
When InTheMoney Return false FORCE
When IsBubble Return false FORCE
When Others Return true Force 

##InTheMoney##
WHEN NOT istournament RETURN false FORCE
When isdon Return false FORCE
WHEN (PlayersLeftInTournament <= PaidPlaces) RETURN true FORCE

##IsBubble##
WHEN NOT istournament RETURN false FORCE
WHEN (PlayersLeftInTournament == (PaidPlaces + 1)) RETURN true FORCE

##TableIsThreeHanded##
WHEN isspin AND nplayersseated = 3 RETURN true FORCE
WHEN istournament AND (NOT isspin) AND maxnplayersdealt = 3 RETURN true FORCE
WHEN (NOT istournament) AND (nplayersdealt = 3) RETURN true FORCE

##TableIsShortHanded##
// Note, In MTTs we can be reseated at tables with varying numbers of players
WHEN istournament AND maxnplayersdealt  > 3 And maxnplayersdealt <= 6 RETURN true FORCE
WHEN (NOT istournament) AND (nplayersdealt > 3) And (nplayersdealt <= 6) RETURN true FORCE

##TableIsFullRing##
WHEN istournament AND maxnplayersdealt > 6 RETURN true FORCE
WHEN (NOT istournament) AND (nplayersdealt > 6) RETURN true FORCE

##TableIsMultiTable##
When NOT istournament Return false FORCE
When ismtt And NOT isfinaltable Return true Force

##PaidPlaces##
WHEN NOT istournament RETURN false FORCE
// TableIsHeadsup is true if OnlyTwoPlayersLeftAtTournamentTable
	// Therefore IsBubble and TableIsHeadsup can coexist 
	// Perhaps change to maxnplayersdealt in OpenPPL_Library_Players_and_Opponents.ohf
WHEN TableIsHeadsup RETURN PaidPlacesHeadsup FORCE
WHEN TableIsThreeHanded RETURN PaidPlacesThreeHanded FORCE
WHEN TableIsShortHanded RETURN PaidPlacesShortHanded FORCE
WHEN TableIsFullRing RETURN PaidPlacesFullRing FORCE
WHEN TableIsMultiTable RETURN PaidPlacesMultiTableTournament FORCE

##PaidPlacesHeadsup##
1

##PaidPlacesThreeHanded##
1

##PaidPlacesShortHanded##
WHEN isdon RETURN 3 FORCE
WHEN Others RETURN 2 FORCE

##PaidPlacesFullRing##
When isdon And maxnplayersdealt = 8 Return 4 Force
WHEN isdon RETURN 5 FORCE
WHEN Others RETURN 3 FORCE

##PaidPlacesMultiTableTournament##
WHEN (mtt_paid_places > 0) RETURN mtt_paid_places FORCE
WHEN Others	RETURN HINT_UnknownPaidPlacesMultiTable FORCE

##PlayersLeftInTournament##
WHEN isspin RETURN nplayersseated FORCE
WHEN NOT istournament RETURN nplayersseated FORCE
WHEN NOT ismtt RETURN nplayersseated FORCE
WHEN Others RETURN PlayersLeftInMultiTableTournament FORCE

##PlayersLeftInMultiTableTournament##
WHEN (mtt_players_remaining > 0) RETURN mtt_players_remaining FORCE
WHEN isfinaltable RETURN nplayersseated FORCE
WHEN Others	RETURN HINT_PlayersLeftInMultiTableTournament FORCE


// ===== SOURCE OpenPPL/OpenPPL_Library/OpenPPL_Library_Update_History.ohf blob=8e8d83ec850d8e46e8c884797f479af6ed78623d =====
##OpenPPL_License_Text##
//*****************************************************************************
//
// OpenPPL Library
//   Supporting functions for OpenPPL.
//   These functions will be loaded by OpenHoldem in the background
//   and will be available both for OpenPPL and OH-script users.
//   This library is mostly written in OH-script,
//   but it can be extended by OpenPPL-functions, as both formats are 100% compatible.
//
// OpenPPL is part of the OpenHoldem project
//   Source code:           https://github.com/OpenHoldem/openholdembot/
//   Source code:           https://github.com/OpenHoldem/openholdembot/releases
//   Forums:                http://www.maxinmontreal.com/forums/index.php
//   Licensed under GPL v3: http://www.gnu.org/licenses/gpl.html
//
// The original PPL (Poker Programming Language) got invented by
//   Shanky Bonusbots:      http://bonusbots.com/support/index.php
//
// Required OpenHoldem version: 11.2.0 or later
//
// Contributors:
//   Bob3456
//   ChuckNeverMuck
//   CoolBotMe123
//   CrumbleSunday
//   Dr.Kaktuz
//   Efu
//   Fn101
//   Fqfq	
//   Gecko
//   JConner
//   Johnny
//   JokeDoke
//   KaeKruse
//   Kyo
//   Lavezzi
//   MerzkiyTipon
//   Morello
//   MrRuder
//   Narfal
//   Nik0
//   NPNG
//   Poker_Dog
//   Postenjak
//   Rambam
//   Relhby
//   Salem
//   Satanikut
//   Stangelnator
//   SteveG1963
//   Strikles
//   SuperBlak
//   TheHighFish
//   ThemAndMe
//   Want2Learn
//   Zolp
//
//*****************************************************************************

//*****************************************************************************
//
// OpenPPL - Update Of History Symbols
//
// For history symbols and other information,
// that can't be retrieved from OH-symbols
// and not from the current gamestate either.
//
//*****************************************************************************

##CalculateBotsLastPreflopActionForUpdateAfterAutoplayerAction##
// This function is a nearly identical copy of BotsLastAction.
// Unfortunately the logical value can change after autoplayer-action,
// but not the technical value (due to symbol-caching)
// and we need both values at the same heartbeat,
// one for execution (bot-logic) and the other one to update the history.
// The most easy solution was this code-clone.
//
// We removed the first lines of BotsLastAction
// WHEN [IsPreflop AND (BotsActionsOnThisRoundIncludingChecks == 0)] RETURN None FORCE
// WHEN (betround != preflop) RETURN BotsLastPreflopAction FORCE
// because BotsActionsOnThisRoundIncludingChecks and BotsLastPreflopAction
// could be [cached] after the first action and we could get wrong results.
// http://www.maxinmontreal.com/forums/viewtopic.php?f=156&t=20395
// Computing BotsLastAction from prevation
// k_prevaction_undefined = -2
// k_prevaction_fold = -1
// k_prevaction_check = 0   // new in OpenHoldem
// k_prevaction_call = 1
// k_prevaction_raise = 2   // min-raise
// k_prevaction_betsize = 3	// "stated wager", i.e. using f$betsize
// k_prevaction_allin = 4
// k_prevaction_jam = 5     // allin with the slider
//
// We do no longer check for successful and failed allins
// because this function gets used for the initialization of BotsLastPreflopAction
// This update happens potentiually multiple times preflop, not only once on the flop,
// and at the same heartbeat when the action was executed,
// so we can't check if the balance is zero, as the casino did not yet update
// and we did not yet scrape again.
WHEN PrevActionWasAllin RETURN RaiseMax FORCE
// Raising (FL and NL)
WHEN ((prevaction == 2) OR (prevaction == 3)) RETURN Raise FORCE
// calling
WHEN (prevaction == 1) RETURN Call FORCE
// Checking postflop
WHEN ((prevaction == 0) AND (betround > 1) AND (currentbet == 0)) RETURN Check FORCE
// Checking preflop
WHEN ((prevaction == 0) AND (betround == 1) AND (currentbet <= bblind)) RETURN Check FORCE
// "Checking" when it was a call
// Actually OpenHoldem does auto-adapt prevaction after such actions
// but we try to be extra safe
WHEN ((prevaction == 0) AND (betround == 1) AND (currentbet > bblind)) RETURN Call FORCE
// Folding (might be used in sitout formulas)
WHEN (prevaction == -1) RETURN Fold FORCE
// No autoplayer-actions, but human being acting at ManualMode
WHEN sitename$openholdem RETURN (HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions + None) FORCE
// None
WHEN (prevaction == -1) RETURN None FORCE
WHEN Others RETURN ERROR_IncorrectBotsLastAction FORCE

##CalculateStartingChips##
// Precondition: first hand, preflop
(currentbet + balance + ante)

##CalculateStartingStackSize##
// Precondition: first hand, preflop
WHEN (StartingChips <= 0) RETURN 0 FORCE
WHEN (bblind > 0) RETURN (StartingChips / bblind) FORCE
WHEN Others RETURN ERROR_Blinds_Not_Recognized_Correctly__Check_Your_TableMap FORCE

##UpdateMemorySymbolsOnHandReset##
WHEN ResetOldGameStateAtHandReset
WHEN Others
WHEN Others SET me_st_MemRaisesBeforeFlop_0
WHEN Others SET me_st_MemRaisesOnFlop_0
WHEN Others SET me_st_MemRaisesOnTurn_0
WHEN Others SET me_st_MemMaxOpponentStackSize_0
WHEN Others SET me_st_MemMinOpponentStackSize_0
WHEN Others SET me_st_MemBotsLastPreflopAction_None
WHEN Others SET me_st_MemBotsLastFlopAction_None
WHEN Others SET me_st_MemBotsLastTurnAction_None
// Reset starting chips, stacksize and bigblind-size once at the beginning of the session
WHEN (handsplayed <= 1) SET me_st_MemStartingChips_0
WHEN (handsplayed <= 1) SET me_st_MemStartingStackSize_0
WHEN (handsplayed <= 1) SET me_st_MemStartingBigBlindSize_0
// Execute UpdateMemorySymbolsOnNewRound unconditionally, but don't do anything
WHEN UpdateMemorySymbolsOnNewRound

##UpdateMemorySymbolsOnNewRound##
WHEN Others SET me_st_MemRaises_0
WHEN Others SET me_st_MemChecks_0
WHEN Others SET me_st_MemCalls_0
WHEN Others SET me_st_MemBets_0

##UpdateMemorySymbolsAfterAutoplayerAction##
// This function is the preferred place to store and update memory symbola
// as it is our turn and we see stable frames, i.e. absence of casino animations
//
// At first we set the flag me_st_MemUpdateOfOpenPPLMemorySymbolsInProgress_true
// as during the update we have partially inconsistent information,
// as the OpenHoldem-symbols are already updated (e.g. didrais, ...).
// This could cause some OpenPPl-symbols like BotsActionsOnThisRoundIncludingChecks
// to be off by one, so we have to adapt.
// http://www.maxinmontreal.com/forums/viewtopic.php?f=120&t=20275&p=142396#p142396
WHEN Others SET me_st_MemUpdateOfOpenPPLMemorySymbolsInProgress_true
WHEN Others SET me_st_MemRaises_Raises
WHEN Others SET me_st_MemChecks_Checks
WHEN Others SET me_st_MemCalls_Calls
WHEN Others SET me_st_MemBets_Bets
WHEN IsPreflop SET me_st_MemBotsLastPreflopAction_CalculateBotsLastPreflopActionForUpdateAfterAutoplayerAction
// CalculateBotsLastPreflopActionForUpdateAfterAutoplayerAction
// can also be used on other betting-rounds, as it is not specific to preflop.
// http://www.maxinmontreal.com/forums/viewtopic.php?f=297&t=20960
WHEN IsFlop    SET me_st_MemBotsLastFlopAction_CalculateBotsLastPreflopActionForUpdateAfterAutoplayerAction
WHEN IsTurn    SET me_st_MemBotsLastTurnAction_CalculateBotsLastPreflopActionForUpdateAfterAutoplayerAction
WHEN IsPreflop SET me_st_MemRaisesBeforeFlop_Raises
WHEN IsFlop SET me_st_MemRaisesOnFlop_Raises
WHEN IsTurn SET me_st_MemRaisesOnTurn_Raises
WHEN (me_re_MemStartingBigBlindSize <= 0) SET me_st_MemStartingBigBlindSize_StartingBigBlindSize
WHEN (me_re_MemStartingChips <= 0) SET me_st_MemStartingChips_StartingChips
WHEN (me_re_MemStartingStackSize <= 0) SET me_st_MemStartingStackSize_StartingStackSize
WHEN (me_re_MemMaxOpponentStackSize <= 0) SET me_st_MemMaxOpponentStackSize_MaxOpponentStackSize
WHEN (me_re_MemMinOpponentStackSize <= 0) SET me_st_MemMinOpponentStackSize_MinOpponentStackSize
// Finally remember a heartbeat ID so that be become able to detect
// if a symbol gets used before the next scrape (e.g by the debug-tab).
// In this case we have to return the new value (e.g. of "Raises")
// and not a computed result based on the "old" value + ActionsSinceLastPlay.
WHEN CreateHeartbeatIDAfterAutoplayerAction
// Terminating the open-ended when-condition above
// to execute the next one for sure.
WHEN Others
// Remember current game-state to avoid duplicte updates
// of memory-symbols in case an action has no effect.
WHEN RememberCurrentGameStateAfterAutoplayeraction
// Terminating the open-ended when-condition above
// to execute the next one for sure.
WHEN Others
WHEN Others SET me_st_MemUpdateOfOpenPPLMemorySymbolsInProgress_false

//*****************************************************************************
//
// Detecting already executed updates of memory-symbols
// that conflict with the normal way of evaluation
//
// Usually we calculate symbols like "Raises" based on old, stable values
// plus RaisesSinceLastPlay (based on nopponentstruelyraising, computed 
// with the info of the current orbit).
// This however does no longer work if we store a new "old" value
// at the end of my turn after an autoplayer action.
// true, all critical work is done, but code in other threads
// (especially the debug-tab) might request these symbols.
// Then OpenHoldem would temporarily display invalid info
// and people would be confused.
// To avoid countless "bug"-reports, we remember and compare
// a heartbeat-ID and then return the new value without
// any computed updates based on an old frame
// (that usually displays some ActionsSinceLastPlay by other players).
//
// Affected are the action counters
// Calls, Checks, Raises
//
//*****************************************************************************

##CreateHeartbeatIDAfterAutoplayerAction##
// As there are no heartbeat-counters 
// and we don't want things to complicated
// we use randomheartbeat as a "nearly unique" ID.
me_st_heartbeatID_randomheartbeat

##OpenPPLHistorySymbolsAlreadyUpdatedThisHeartbeatAfterAutoplayerAction##
WHEN (me_re_heartbeatID == randomheartbeat) RETURN true FORCE

//*****************************************************************************
//
// Avoid duplicate updates in case an autoplayer action had no effect.
// In this case we must not update the symbols again (increase counters, ...).
// To prevent this problem we remember the current game-state (partially)
// and then verify that it has changed.
// http://www.maxinmontreal.com/forums/viewtopic.php?f=110&t=19407
//
//*****************************************************************************

##GameStateChangedSinceLastAutoplayerAction##
// Change in dealerchair => new hand
   (dealerchair != me_re_MemOldGameStateDealerChair)
// Change in currentbet => we did act 
// and the autoplayer executed successfully   
OR (currentbet  != me_re_MemOldGameStateCurrentBet)
// Change in potsize: somebody else behind us acted, 
// so we checked or folded successfully
OR (pot			    != me_re_MemOldGameStatePotSize)
// Change in betround, if everybody checked 
// and potsize is the same
OR (betround    != me_re_MemOldGameStateBetround)

##RememberCurrentGameStateAfterAutoplayeraction##
// We can't use AND and OR here because of short circuiting.
// We must use an operator that evaluates both sites.
// The final result is meaningless.
    me_st_MemOldGameStateCurrentBet_currentbet
XOR me_st_MemOldGameStatePotSize_pot
XOR me_st_MemOldGameStateBetround_betround
// _dealerchair is a multiplexer-postfix nowadays
// that gets textually replaced by its current value.
// So we need an additional underscore here for a correct me_st_x_y-command.
XOR me_st_MemOldGameStateDealerChair__dealerchair

##ResetOldGameStateAtHandReset##
// We have to explicitly reset the old game-state at hand-reset,
// as RememberCurrentGameStateAfterAutoplayeraction won't get executed
// if a user simulates e.g. at Manualmode and just clicks "Reset".
// http://www.maxinmontreal.com/forums/viewtopic.php?f=261&t=20226#p142447
    me_st_MemOldGameStateDealerChair_0
XOR me_st_MemOldGameStateCurrentBet_0
XOR me_st_MemOldGameStatePotSize_0
XOR me_st_MemOldGameStateBetround_0

// ===== SOURCE OpenPPL/OpenPPL_Library/OpenPPL_Library_Verbosity.ohf blob=97c09357ce1320c5d97f44f5c7c43139d6bdfebd =====
##OpenPPL_License_Text##
//*****************************************************************************
//
// OpenPPL Library
//   Supporting functions for OpenPPL.
//   These functions will be loaded by OpenHoldem in the background
//   and will be available both for OpenPPL and OH-script users.
//   This library is mostly written in OH-script,
//   but it can be extended by OpenPPL-functions, as both formats are 100% compatible.
//
// OpenPPL is part of the OpenHoldem project
//   Source code:           https://github.com/OpenHoldem/openholdembot/
//   Source code:           https://github.com/OpenHoldem/openholdembot/releases
//   Forums:                http://www.maxinmontreal.com/forums/index.php
//   Licensed under GPL v3: http://www.gnu.org/licenses/gpl.html
//
// The original PPL (Poker Programming Language) got invented by
//   Shanky Bonusbots:      http://bonusbots.com/support/index.php
//
// Required OpenHoldem version: 11.2.0 or later
//
// Contributors:
//   Bob3456
//   ChuckNeverMuck
//   CoolBotMe123
//   CrumbleSunday
//   Dr.Kaktuz
//   Efu
//   Fn101
//   Fqfq	
//   Gecko
//   JConner
//   Johnny
//   JokeDoke
//   KaeKruse
//   Kyo
//   Lavezzi
//   MerzkiyTipon
//   Morello
//   MrRuder
//   Narfal
//   Nik0
//   NPNG
//   Poker_Dog
//   Postenjak
//   Rambam
//   Relhby
//   Salem
//   Satanikut
//   Stangelnator
//   SteveG1963
//   Strikles
//   SuperBlak
//   TheHighFish
//   ThemAndMe
//   Want2Learn
//   Zolp
//
//*****************************************************************************

//*****************************************************************************
//
// OpenPPL - Verbosity
//
// Some OpenHoldem-symbols are awfully ill-named,
// thanks to its WinHoldem heritage.
// Some symbols are named as aweful as rais, swag, $$pr0, etc.
// We provide meaningful names here to make this library more readable.
//
//*****************************************************************************

##IsPreflop##
(betround == preflop)

##IsFlop##
(betround == flop)

##IsTurn##
(betround == turn)

##IsRiver##
(betround == river)

##IsPostflop##
NOT IsPreflop

##RankOfFirstHoleCard##
$$pr0

##RankOfSecondHoleCard##
$$pr1

##RankOfThirdHoleCard##
$$pr2

##RankOfFourthHoleCard##
$$pr3

##RankOfFirstFlopCard##
$$cr0

##RankOfSecondFlopCard##
$$cr1

##RankOfThirdFlopCard##
$$cr2

##RankOfTurnCard##
$$cr3

##RankOfRiverCard##
$$cr4

##FirstHoleCardSuit##
$$ps0

##SecondHoleCardSuit##
$$ps1

##ThirdHoleCardSuit##
$$ps2

##FourthHoleCardSuit##
$$ps3

##SuitOfFirstFlopCard##
$$cs0

##SuitOfSecondFlopCard##
$$cs1

##SuitOfThirdFlopCard##
$$cs2

##SuitOfTurnCard##
$$cs3

##SuitOfRiverCard##
$$cs4

##MadeHandThirdCardRank##
// Useful for the determination of kickers
// The last 20 bits of pokerval encode the ranks of our made hand
// Four bits per card
(pokerval >> 8) & 0x0F

##MadeHandFourthCardRank##
// Useful for the determination of kickers
// The last 20 bits of pokerval encode the ranks of our made hand
// Four bits per card
(pokerval >> 4) & 0x0F

##MadeHandFifthCardRank##
// Useful for the determination of kickers
// The last 20 bits of pokerval encode the ranks of our made hand
// Four bits per card
(pokerval >> 0) & 0x0F

//*****************************************************************************
//
// OpenPPL - Aliases
//
// Alternative names for some symbols
//
//*****************************************************************************

##FirstFlopCard##
RankOfFirstFlopCard

##SecondFlopCard##
RankOfSecondFlopCard

##ThirdFlopCard##
RankOfThirdFlopCard

##TurnCard##
RankOfTurnCard

##RiverCard##
RankOfRiverCard

##FirstFlopSuit##
SuitOfFirstFlopCard

##SecondFlopSuit##
SuitOfSecondFlopCard

##ThirdFlopSuit##
SuitOfThirdFlopCard

##TurnSuit##
SuitOfTurnCard

##RiverSuit##
SuitOfRiverCard

